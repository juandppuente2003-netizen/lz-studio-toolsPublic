{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/client",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/site?__lz_path=index.html"
    },
    {
      "source": "/:path*",
      "destination": "/api/site?__lz_path=:path*"
    }
  ]
}
