{
  "name": "lz-plus",
  "productName": "LZ-PLUS",
  "version": "1.0.0",
  "description": "LZ-PLUS para Windows",
  "main": "main.js",
  "author": "LZ-PLUS",
  "license": "UNLICENSED",
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.lzplus.windows",
    "productName": "LZ-PLUS",
    "files": ["main.js", "lz-plus.html", "lz-servidor.js", "icon.png"],
    "asarUnpack": ["node_modules/ffmpeg-static/**"],
    "directories": { "output": "dist" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LZ-PLUS",
      "artifactName": "LZ-PLUS-Windows-instalador.exe"
    },
    "portable": { "artifactName": "LZ-PLUS-Windows-portable.exe" }
  }
}
