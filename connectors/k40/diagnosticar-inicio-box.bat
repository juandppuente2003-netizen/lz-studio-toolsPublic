@echo off
title LZ Studio - Diagnostico de inicio y proceso
echo LZ Studio - Diagnostico de inicio. No modifica Windows ni envia movimientos.
echo.
powershell.exe -NoProfile -Command "$ErrorActionPreference='Continue'; Write-Host '--- INICIO REGISTRADO ---'; $startup=(Get-ItemProperty -LiteralPath 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Run' -Name 'LZStudioK40' -ErrorAction SilentlyContinue).LZStudioK40; Write-Host $startup; Write-Host ''; Write-Host '--- PROCESO EN PUERTO 17840 ---'; $connections=Get-NetTCPConnection -LocalPort 17840 -State Listen -ErrorAction SilentlyContinue; if(-not $connections){Write-Host 'No hay ningun conector escuchando en el puerto.'}; foreach($owner in ($connections.OwningProcess | Sort-Object -Unique)){ $proc=Get-CimInstance Win32_Process -Filter ('ProcessId='+$owner); Write-Host ('PID: '+$owner); Write-Host ('Ejecutable: '+$proc.ExecutablePath); Write-Host ('Inicio del proceso: '+$proc.CreationDate); $scripts=[regex]::Matches($proc.CommandLine,'(?i)[A-Z]:\\[^:]*?(?:background[.]pyw|bridge[.]py)') | ForEach-Object {$_.Value}; foreach($script in $scripts){Write-Host ('Archivo: '+$script); $source=Join-Path (Split-Path -Parent $script) 'bridge.py'; if(Test-Path -LiteralPath $source){$text=Get-Content -LiteralPath $source -Raw; $version=[regex]::Match($text,'bridgeVersion[^0-9]*([0-9]+[.][0-9]+[.][0-9]+)').Groups[1].Value; Write-Host ('Version en esa carpeta: '+$version)}} }; Write-Host ''; Write-Host '--- ESTADO HTTP ---'; try { $pairPath=Join-Path $env:LOCALAPPDATA 'LZStudioTools\K40\pairing.json'; $pair=Get-Content -LiteralPath $pairPath -Raw | ConvertFrom-Json; $headers=@{Origin='https://www.lzstudiotools.com';Authorization=('Bearer '+$pair.token)}; $r=Invoke-RestMethod -Uri 'http://127.0.0.1:17840/status' -Headers $headers -TimeoutSec 8; [pscustomobject]@{VersionEnEjecucion=$r.bridgeVersion;Estado=$r.state;Operacion=$r.operation;USB=$r.controllerStatus;Mensaje=$r.message} | Format-List } catch {Write-Host ('No responde: '+$_.Exception.Message)}; Write-Host ''; Write-Host '--- ULTIMOS ERRORES ---'; $log=Join-Path $env:LOCALAPPDATA 'LZStudioTools\K40\connector.log'; if(Test-Path -LiteralPath $log){Get-Content -LiteralPath $log -Tail 15 | ForEach-Object {if($pair.token){Write-Host ($_.Replace([string]$pair.token,'[CODIGO OCULTO]'))} else {Write-Host $_}}} else {Write-Host 'No existe connector.log'}"
echo.
echo Envia capturas de esta ventana, incluyendo inicio registrado y proceso.
pause
